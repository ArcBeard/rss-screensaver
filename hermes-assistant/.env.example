# Hermes Assistant — environment template
# Usage: cp .env.example .env  then fill in the values below.
# The .env file is read automatically by `docker compose up`.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Secret key used to sign sessions. Generate one with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# ── OPTIONAL — MODEL SELECTION ───────────────────────────────────────────────

# Ollama model shown by default in the UI.
# The model must already be pulled on your host:
#   ollama pull hermes3              # Hermes 3 (Llama-3.1 base, 8B default)
#   ollama pull hermes3:70b          # larger variant
#   ollama pull nous-hermes2         # Hermes 2 (Mistral base)
#   ollama pull nous-hermes2:34b
DEFAULT_MODELS=hermes3:latest

# ── OPTIONAL — ENABLE CLOUD / EXTERNAL APIs ──────────────────────────────────
# These are all disabled by default. Uncomment and fill in ONLY if needed.

# OpenAI-compatible endpoint (covers OpenAI, Anthropic via proxy, Azure, etc.)
# ENABLE_OPENAI_API=true
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# ── OPTIONAL — NETWORK ───────────────────────────────────────────────────────

# If your Ollama instance listens on a non-default address or port:
# OLLAMA_BASE_URL=http://192.168.1.x:11434
